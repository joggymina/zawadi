// ─────────────────────────────────────────────────────────────────────────
// Zawadi — core data model
//
// Design notes:
// - Money is stored as Decimal, never Float, to avoid rounding drift.
// - InvestmentAccount holds a ledger-derived balance (principal + interest),
//   but every movement is also written to Transaction — the Transaction
//   table is the source of truth; account balances are a cached projection
//   that a reconciliation job can always rebuild from transactions.
// - PaymentIntent exists now (unused by business logic yet) so that when
//   M-PESA (Daraja) integration is added, deposits/withdrawals plug into
//   the same shape without a schema migration that touches money tables.
// - LoanRepayment requires admin approval before funders are credited —
//   modeled explicitly as a status, not inferred from side effects.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  phoneNumber  String    @unique
  passwordHash String
  role         Role      @default(USER)
  kycStatus    KycStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account              InvestmentAccount?
  transactions         Transaction[]
  loansAsBorrower      Loan[]                      @relation("BorrowerLoans")
  loanFundings         LoanFunding[]
  guarantorFor         LoanGuarantor[]
  repaymentShares      LoanRepaymentDistribution[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  paymentIntents       PaymentIntent[]
  reviewedRepayments   LoanRepayment[]             @relation("ReviewedBy")

  @@index([phoneNumber])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Investment ledger ───────────────────────────────────────────────────

model InvestmentAccount {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  principalBalance Decimal  @db.Decimal(18, 2) @default(0)
  interestBalance  Decimal  @db.Decimal(18, 2) @default(0)
  lastAccrualAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  LOAN_FUND
  LOAN_RETURN
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  ADJUSTMENT
}

// Append-only. Never update or delete a Transaction row in application code —
// corrections are made with an offsetting ADJUSTMENT row.
model Transaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         TxType
  amount       Decimal  @db.Decimal(18, 2)
  balanceAfter Decimal  @db.Decimal(18, 2)
  referenceId  String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Payments (placeholder for M-PESA / Daraja integration) ─────────────

enum PaymentIntentType {
  DEPOSIT
  WITHDRAWAL
}

enum PaymentIntentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PaymentIntent {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  type         PaymentIntentType
  amount       Decimal             @db.Decimal(18, 2)
  status       PaymentIntentStatus @default(PENDING)
  providerRef  String? // e.g. Daraja CheckoutRequestID / M-PESA receipt
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  @@index([userId, status])
}

// ── Loans ────────────────────────────────────────────────────────────────

enum LoanStatus {
  PENDING_GUARANTORS
  OPEN
  REPAYING
  REPAID
  DEFAULTED
  CANCELLED
}

model LoanPackage {
  id             String   @id @default(uuid())
  name           String
  durationHours  Int
  graceHours     Int      @default(0)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  loans Loan[]
}

model Loan {
  id              String     @id @default(uuid())
  borrowerId      String
  borrower        User       @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  amount          Decimal    @db.Decimal(18, 2)
  purpose         String?
  interestRateApr Decimal    @db.Decimal(6, 3)
  status          LoanStatus @default(PENDING_GUARANTORS)

  packageId       String?
  package         LoanPackage? @relation(fields: [packageId], references: [id])
  dueAt           DateTime?

  principalOwed   Decimal    @db.Decimal(18, 2) @default(0)
  interestOwed    Decimal    @db.Decimal(18, 2) @default(0)
  fundedAmount    Decimal    @db.Decimal(18, 2) @default(0)
  lastAccrualAt   DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  guarantors  LoanGuarantor[]
  fundings    LoanFunding[]
  repayments  LoanRepayment[]

  @@index([borrowerId])
  @@index([status])
  @@index([packageId])
}

// Snapshot of the guarantor's qualifying balance at pledge time, so a
// guarantor withdrawing funds later doesn't silently invalidate history.
model LoanGuarantor {
  id                 String   @id @default(uuid())
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id])
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  balanceAtPledge    Decimal  @db.Decimal(18, 2)
  pledgedAt          DateTime @default(now())

  @@unique([loanId, userId])
}

model LoanFunding {
  id        String   @id @default(uuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id])
  funderId  String
  funder    User     @relation(fields: [funderId], references: [id])
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([funderId])
}

enum RepaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A borrower's payment is applied to the loan's outstanding balance
// immediately (interestOwed first, then principalOwed) — but the payout
// to funders (LoanRepaymentDistribution rows) is only realized once an
// admin approves. Rejecting restores principalOwed/interestOwed from the
// *Before snapshot and refunds the borrower.
model LoanRepayment {
  id                  String          @id @default(uuid())
  loanId              String
  loan                Loan            @relation(fields: [loanId], references: [id])
  amount              Decimal         @db.Decimal(18, 2)
  status              RepaymentStatus @default(PENDING)
  principalOwedBefore Decimal         @db.Decimal(18, 2)
  interestOwedBefore  Decimal         @db.Decimal(18, 2)
  createdAt           DateTime        @default(now())
  reviewedAt          DateTime?
  reviewedById        String?
  reviewedBy          User?           @relation("ReviewedBy", fields: [reviewedById], references: [id])

  distributions LoanRepaymentDistribution[]

  @@index([loanId])
  @@index([status])
}

model LoanRepaymentDistribution {
  id          String        @id @default(uuid())
  repaymentId String
  repayment   LoanRepayment @relation(fields: [repaymentId], references: [id])
  funderId    String
  funder      User          @relation(fields: [funderId], references: [id])
  amount      Decimal       @db.Decimal(18, 2)
}

// ── Admin-configurable settings ─────────────────────────────────────────

// Singleton row (id is always 1). Read through a cached accessor in
// application code so a hot path doesn't hit the DB on every request.
model AdminSettings {
  id                        Int      @id @default(1)
  investAnnualRatePct       Decimal  @db.Decimal(6, 3) @default(10.5)
  loanAnnualRatePct         Decimal  @db.Decimal(6, 3) @default(18)
  guarantorsRequired        Int      @default(5)
  guarantorCoverageExtraPct Decimal  @db.Decimal(6, 3) @default(5)
  /// Percent of each withdrawal taken as platform fee (e.g. 2.5 = 2.5%).
  withdrawFeePct            Decimal  @db.Decimal(6, 3) @default(2.5)
  /// Percent of loan interest kept by the platform when repayments are distributed (wired in a later phase).
  platformInterestSharePct  Decimal  @db.Decimal(6, 3) @default(10)
  updatedAt                 DateTime @updatedAt
}

model Offer {
  id          String   @id @default(uuid())
  title       String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Audit trail ──────────────────────────────────────────────────────────

// Every privileged or money-moving action writes here. Required for any
// future regulatory review, and invaluable for debugging disputes.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}
