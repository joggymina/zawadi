# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://zawadi:zawadi@localhost:5432/zawadi

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_hex_chars_min_32_bytes
JWT_REFRESH_SECRET=replace_with_a_different_64_hex_chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173

# HashPay (HashBack) — M-Pesa STK deposits
# Get api_key + account_id from https://www.hashback.co.ke dashboard
HASHPAY_API_KEY=
HASHPAY_ACCOUNT_ID=
# Optional: HMAC secret for X-Hashpay-Signature on webhooks
HASHPAY_WEBHOOK_SECRET=
# Default: https://api.hashback.co.ke
HASHPAY_BASE_URL=https://api.hashback.co.ke

# PayHero (when admin selects PayHero)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_TOKEN=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://YOUR_API_HOST/api/payments/payhero/callback
